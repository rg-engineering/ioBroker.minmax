{
  "name": "iobroker.minmax",
  "version": "1.2.16",
  "description": "ioBroker min max Adapter",
  "author": {
    "name": "René G.",
    "email": "info@rg-enginerring.eu"
  },
  "homepage": "https://github.com/rg-engineering/ioBroker.minmax",
  "license": "MIT",
  "keywords": [
    "minimum",
    "maximum",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rg-engineering/ioBroker.minmax.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "cron": "^4.4.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "main": "build/main.js",
  "scripts": {
    "test": "npm run test:package",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "0-clean": "node tasks.js --0-clean",
    "1-npm": "node tasks.js --1-npm",
    "2-build": "node tasks.js --2-build",
    "3-copy": "node tasks.js --3-copy",
    "4-patch": "node tasks.js --4-patch",
    "build": "npm run build-backend  && npm pack",
    "build-backend": "tsc -p tsconfig.build.json",
    "npm": "npm i && cd src-admin && npm i -f"
  },
  "bugs": {
    "url": "https://github.com/rg-engineering/ioBroker.minmax/issues"
  },
  "files": [
    "admin/",
    "admin{,/!(i18n)/**}/flat.txt",
    "admin/icons",
    "docs/",
    "!lib/",
    "!.vscode",
    "!.github",
    "!.git",
    "!.gitignore",
    "!.gitattributes",
    "!node_modules",
    "!tasks",
    "!.idea",
    "!test",
    "!typings",
    "!www/",
    "io-package.json",
    "LICENSE",
    "!main.js",
    "build/",
    "!readme.txt",
    "!docs/iconos.zip",
    "!docs/old_docu",
    "!docs/iconos"
  ],
  "readmeFilename": "README.md"
}
